# HTTPS only. Set these variables in the launching process.
ODYSSEIA_HTTPS_ADDR=127.0.0.1:8443
ODYSSEIA_TLS_CERT_FILE=
ODYSSEIA_TLS_KEY_FILE=

# Require sslmode=verify-full; trust the database CA using sslrootcert.
# Use separate runtime and migration identities.
ODYSSEIA_DATABASE_URL=
ODYSSEIA_MIGRATION_DATABASE_URL=

# Per-API concurrent write transactions, before acquiring a pool connection.
# 0 = automatic headroom for identity/reads (pool 16 -> 10 writers). Must not exceed pool_max_conns
# in the database URL. Replicas share a database: budget their pools together.
ODYSSEIA_MAX_WRITE_TRANSACTIONS=0

# Group member ceiling, including the owner. Default 50. Cannot exceed the database ceiling of 50.
# Direct conversations are always two people and do not use this limit.
ODYSSEIA_CONVERSATION_MEMBER_LIMIT=50

# Cloudflare R2 (S3-compatible) for conversation image and voice objects.
# The API streams uploads itself and signs short-lived GET URLs. Do not put these
# values in the client. Leave ODYSSEIA_R2_ENDPOINT empty to use
# https://<account id>.r2.cloudflarestorage.com. Region is required by the AWS SDK
# and is "auto" for R2.
ODYSSEIA_R2_ACCOUNT_ID=
ODYSSEIA_R2_ACCESS_KEY_ID=
ODYSSEIA_R2_SECRET_ACCESS_KEY=
ODYSSEIA_R2_BUCKET=
ODYSSEIA_R2_ENDPOINT=
ODYSSEIA_R2_REGION=auto

# Attachment budgets. Unset values use the defaults below. None may exceed the
# database ceiling: 10MiB per object, 32768px edge, 67108864 pixels, 5 minutes,
# 4 attachments per message, 1GiB stored per user, 60 uploads per minute, 5m presign.
# Defaults: 10MiB, 8192px edge, 16777216 pixels, 300000ms, 10 uploads/minute,
# 100MiB per user, 60s presign, 4 per message.
# Retention from upload time for cmd/attachment-sweep. Go duration, no day unit.
# Unset means 168h. Allowed range is 1h to 8784h. The API process does not read
# this and does not delete objects. Schedule the sweep before enabling an R2
# lifecycle rule of 8 days on the conversations/ prefix.
# See docs/P4图片与语音附件-2026-10-31.md.
# ODYSSEIA_ATTACHMENT_RETENTION=168h
ODYSSEIA_ATTACHMENT_MAX_BYTES=10485760
ODYSSEIA_ATTACHMENT_MAX_EDGE=8192
ODYSSEIA_ATTACHMENT_MAX_PIXELS=16777216
ODYSSEIA_ATTACHMENT_MAX_VOICE_MS=300000
ODYSSEIA_ATTACHMENT_UPLOADS_PER_MINUTE=10
ODYSSEIA_ATTACHMENT_USER_QUOTA_BYTES=104857600
ODYSSEIA_ATTACHMENT_PRESIGN_TTL=60s
ODYSSEIA_ATTACHMENT_MAX_PER_MESSAGE=4

# JWT access tokens: exact trusted issuer, API audience and explicit HTTPS JWKS URL.
# With the mock IdP, issuer is ODYSSEIA_MOCK_IDP_ISSUER and the JWKS URL is {issuer}/oauth/v2/keys.
# Optional CA bundle replaces system roots for this JWKS client only.
ODYSSEIA_AUTH_ISSUER=
ODYSSEIA_AUTH_AUDIENCE=
ODYSSEIA_AUTH_JWKS_URL=
ODYSSEIA_AUTH_CA_FILE=

# Development OIDC issuer. The listen address must be loopback (127.0.0.1, ::1, or localhost).
# Discovery is {issuer}/.well-known/openid-configuration.
# JWKS is {issuer}/oauth/v2/keys. POST /mock/token mints an access token for loopback clients
# and always uses ODYSSEIA_MOCK_IDP_AUDIENCE. The request cannot override audience.
# POST /oauth/v2/token is reserved for a future ZITADEL token endpoint.
ODYSSEIA_MOCK_IDP_ADDR=127.0.0.1:9443
ODYSSEIA_MOCK_IDP_ISSUER=https://127.0.0.1:9443
ODYSSEIA_MOCK_IDP_AUDIENCE=odysseia-api
ODYSSEIA_MOCK_IDP_TLS_CERT_FILE=
ODYSSEIA_MOCK_IDP_TLS_KEY_FILE=

# Operator-only provision-user command; never used by the API process.
ODYSSEIA_PROVISION_SUBJECT=

# Operator-only creation of an independent members-only test forum.
ODYSSEIA_FORUM_TITLE=
ODYSSEIA_FORUM_MEMBER_IDS=

# Distinct random connection-signing and private HTTPS proxy credentials.
# At least 32 random bytes each. The proxy key never goes to clients.
ODYSSEIA_REALTIME_CONNECTION_SECRET=
ODYSSEIA_REALTIME_PROXY_SECRET=

# Operator-only audited membership removal. Reuse the operation UUID on retries.
ODYSSEIA_OPERATION_ID=
ODYSSEIA_FORUM_ID=
ODYSSEIA_FORUM_MEMBER_ID=
ODYSSEIA_OPERATOR=
ODYSSEIA_CHANGE_REASON=

# Public emoji bucket. Must be a different bucket from the conversation bucket above.
# Account, keys, endpoint and region are optional and fall back to ODYSSEIA_R2_*.
# The public URL is the https prefix placed before the content-hash object key.
# It must not have a query, user info, or trailing slash.
# ODYSSEIA_EMOJI_MAX_BYTES defaults to 262144 and cannot exceed it.
# ODYSSEIA_EMOJI_MAX_EDGE defaults to 128 and cannot exceed 256.
# ODYSSEIA_EMOJI_SITE_OWNER_IDS is a comma-separated list of local user UUIDs.
# An empty list means nobody can create or delete site emoji. The identity
# catalog owner role is a forum role, not this directory owner.
ODYSSEIA_EMOJI_R2_BUCKET=
ODYSSEIA_EMOJI_PUBLIC_BASE_URL=
ODYSSEIA_EMOJI_R2_ACCOUNT_ID=
ODYSSEIA_EMOJI_R2_ACCESS_KEY_ID=
ODYSSEIA_EMOJI_R2_SECRET_ACCESS_KEY=
ODYSSEIA_EMOJI_R2_ENDPOINT=
ODYSSEIA_EMOJI_R2_REGION=
ODYSSEIA_EMOJI_MAX_BYTES=262144
ODYSSEIA_EMOJI_MAX_EDGE=128
ODYSSEIA_EMOJI_SITE_OWNER_IDS=

# Read-only aggregate observer command; only SELECT on realtime_backlog.
ODYSSEIA_OBSERVER_DATABASE_URL=
# Engineering warning threshold, not an end-user delivery SLA.
ODYSSEIA_BACKLOG_WARN_AFTER=30s
