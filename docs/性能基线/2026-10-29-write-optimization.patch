+// appendReply requires the stream lock and validated references. RETURNING
+// supplies the authoritative sequence and timestamp before encoding the event.
+func appendReply(ctx context.Context, tx pgx.Tx, topicID, actor string, draft forum.ReplyDraft, requestID string, digest []byte) (forum.Entry, error) {
+	entry := forum.Entry{Message: message.Message{ID: uuid.NewString(), StreamID: topicID, AuthorID: actor, Body: draft.Body, QuoteID: draft.QuoteID}, RootID: draft.RootID}
+	err := tx.QueryRow(ctx, `WITH next_position AS (
+		UPDATE odysseia.message_streams SET last_position = last_position + 1 WHERE id=$2 RETURNING last_position
+	)
+	INSERT INTO odysseia.messages(id,stream_id,position,author_id,body,quote_id,request_id,request_hash)
+	SELECT $1,$2,last_position,$3,$4,NULLIF($5,'')::uuid,NULLIF($6,'')::uuid,$7 FROM next_position
+	RETURNING position,created_at`, entry.ID, topicID, actor, draft.Body, draft.QuoteID, requestID, digest).Scan(&entry.Sequence, &entry.CreatedAt)
+	if err != nil {
+		return forum.Entry{}, err
+	}
+	payload, err := forumEventPayload("topic:"+topicID, "forum.message.created", topicID, entry.Sequence, entry)
+	if err != nil {
+		return forum.Entry{}, err
+	}
+	// Both inputs are now known. Close drains the batch and propagates errors
+	// before BeginFunc can commit the body, relation and event together.
+	batch := &pgx.Batch{}
+	batch.Queue(insertForumEntrySQL, topicID, entry.ID, draft.RootID)
+	batch.Queue(insertForumEventSQL, payload)
+	return entry, tx.SendBatch(ctx, batch).Close()
+}
