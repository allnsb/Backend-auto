+func NewForums(pool *pgxpool.Pool) *Forums {
+	// The remaining transaction connections can serve identity and reads.
+	// A one-connection pool has no reserve; this is a per-instance budget.
+	poolLimit := pool.Config().MaxConns
+	readReserve := max(int32(1), poolLimit/4)
+	writers := max(int64(1), int64(poolLimit-readReserve))
+	return &Forums{pool: pool, writes: newWriteAdmission(writers, forumWriteQueueLimit)}
+}
 
